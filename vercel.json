{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/signal", "destination": "/", "permanent": true },
    { "source": "/signal/", "destination": "/", "permanent": true },
    { "source": "/hr/signal", "destination": "/hr", "permanent": true },
    { "source": "/hr/signal/", "destination": "/hr", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
